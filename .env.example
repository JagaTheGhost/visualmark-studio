# VisualMark Studio - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Optional: GitHub Personal Access Token to avoid GitHub API rate limiting during repo analysis
# Format: ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# Optional: Custom backend daemon port (Default: 8000)
PORT=8000

# Optional: Electron development flags
# VITE_DEV_SERVER=true
