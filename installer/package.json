{
  "name": "visualmark-studio-installer",
  "productName": "VisualMark Studio Setup",
  "version": "1.1.3",
  "description": "Next-Generation Glassmorphic Installer for VisualMark Studio",
  "author": "JagaTheGhost",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.visualmark.studio.installer",
    "productName": "VisualMark Studio Setup",
    "copyright": "Copyright © 2026 JagaTheGhost",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "engine.cjs",
      "index.html",
      "uninstaller.html",
      "styles.css",
      "renderer.js",
      "uninstaller-renderer.js",
      "assets/**/*",
      "payload/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "legalTrademarks": "VisualMark Studio"
    },
    "portable": {
      "artifactName": "VisualMark-Studio-Setup.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
